<div class="tab flexrow {{tabs.[resources].cssClass}}" data-group="primary" data-tab="resources">
    <div class="flexrow">
        <section class="profile-picture">
            <header class="header-field">
                <span>{{localize "CS.sheets.house.labels.coatOfArms"}}</span>
            </header>
            <div class="profile-img-container flex">
                <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}" alt="{{actor.name}} Picture" />
            </div>
            <header class="header-field motto">
                <span>{{localize "CS.sheets.house.labels.motto"}}</span>
            </header>
            <div>
                <input  class="field center" type="text"  name="system.motto"  value="{{house.motto}}"  data-dtype="String"/>
            </div>
        </section>
        <section class="flex2">
            <header class="header-field">
                <span>{{localize "CS.sheets.house.fortune.title"}}</span>
            </header>
            <ol class="list family-list">
                <li class="list-header flexrow">
                    <label class="size75">{{localize "CS.sheets.house.labels.steward"}}</label>
                    <div class="center">{{localize "CS.sheets.house.fortune.lawModifier"}}</div>
                    <div class="center">{{localize "CS.sheets.house.fortune.populationModifier"}}</div>
                    <div class="center">{{localize "CS.sheets.house.fortune.holdingModifier"}}</div>
                    <div class="center capitalize">{{localize "CS.constants.specialties.stewardship"}}</div>
                    <div class="field item-controls"></div>
                </li>
                {{#if house.steward.id}}
                <li class="item flexrow" data-actor-id="{{house.steward.id}}">
                    <label  class="link-field member-name size75" data-action="openActor" data-id="{{house.steward.id}}"><a>{{house.steward.name}}</a></label>
                    <div class="center">{{house.fortune.lawMod}}</div>
                    <div class="center">{{house.fortune.populationMod}}</div>
                    <div class="center">{{house.fortune.holdingsMod}}</div>
                    <div class="rollable center" data-action="roll" data-roll="formula:{{localize "CS.constants.specialties.stewardship"}}:{{formulaToStr house.fortune.formula}}">
                        <a>{{format-formula house.fortune.formula}}</a>
                    </div>
                    <div class="field item-controls">
                        <a class="item-control" data-id="{{house.steward.id}}" data-role="STEWARD" data-action="removeMember"><i class="fas fa-trash"></i></a>
                    </div>
                </li>
                {{else}}
                    <li class="item draggable flexrow">
                        <div class="center">{{localize "CS.messages.notStewardLinked"}}</div>
                    </li>
                {{/if}}
            </ol>
            <header class="header-field">
                <span>{{localize "CS.sheets.house.resources.title"}}</span>
                {{#if owner}}
                    <span class="item-controls regenerate-resources"><a data-action="regenerateResources" data-tooltip="CS.sheets.house.resources.regenerate"><i class="fas fa-sync"></i></a></span>
                {{/if}}
            </header>
            <div class="resources-list list">
                {{> (houseResourceItem)
                        owner=owner
                        resourceName="defense"
                        resourceNameKeyword="CS.sheets.house.resources.defense"
                        startingValue=house.defense.total
                        description=house.defense.description
                }}
                {{> (houseResourceItem)
                        owner=owner
                        resourceName="influence"
                        resourceNameKeyword="CS.sheets.house.resources.influence"
                        startingValue=house.influence.total
                        description=house.influence.description
                }}
                {{> (houseResourceItem)
                        owner=owner
                        resourceName="lands"
                        resourceNameKeyword="CS.sheets.house.resources.lands"
                        startingValue=house.lands.total
                        description=house.lands.description
                }}
                {{> (houseResourceItem)
                        owner=owner
                        resourceName="law"
                        resourceNameKeyword="CS.sheets.house.resources.law"
                        startingValue=house.law.total
                        description=house.law.description
                }}
                {{> (houseResourceItem)
                        owner=owner
                        resourceName="population"
                        resourceNameKeyword="CS.sheets.house.resources.population"
                        startingValue=house.population.total
                        description=house.population.description
                }}
                {{> (houseResourceItem)
                        owner=owner
                        resourceName="power"
                        resourceNameKeyword="CS.sheets.house.resources.power"
                        startingValue=house.power.total
                        description=house.power.description
                }}
                {{> (houseResourceItem)
                        owner=owner
                        resourceName="wealth"
                        resourceNameKeyword="CS.sheets.house.resources.wealth"
                        startingValue=house.wealth.total
                        description=house.wealth.description
                }}
            </div>
        </section>
    </div>
</div>
