<div class="tab flexrow holdings {{tabs.[holdings].cssClass}}" data-group="primary" data-tab="holdings">
    {{#if house.defense.hasHoldings}}
        {{> (resourceHoldings) resourceName="CS.sheets.house.resources.defense" holdings=house.holdings.defense resourceTotal=house.defense.total resourceInvested=house.defense.invested}}
    {{/if}}
    {{#if house.influence.hasHoldings}}
        {{> (resourceHoldings) resourceName="CS.sheets.house.resources.influence" holdings=house.holdings.influence resourceTotal=house.influence.total resourceInvested=house.influence.invested}}
    {{/if}}
    {{#if house.law.hasHoldings}}
        {{> (resourceHoldings) resourceName="CS.sheets.house.resources.law"  holdings=house.holdings.law resourceTotal=house.law.total resourceInvested=house.law.invested}}
    {{/if}}
    {{#if house.lands.hasHoldings}}
        {{> (resourceHoldings) resourceName="CS.sheets.house.resources.lands"  holdings=house.holdings.lands resourceTotal=house.lands.total resourceInvested=house.lands.invested}}
    {{/if}}
    {{#if house.population.hasHoldings}}
        {{> (resourceHoldings) resourceName="CS.sheets.house.resources.population"  holdings=house.holdings.population resourceTotal=house.population.total resourceInvested=house.population.invested}}
    {{/if}}
    {{#if house.power.hasHoldings}}
        {{> (resourceHoldings) resourceName="CS.sheets.house.resources.power" holdings=house.holdings.power resourceTotal=house.power.total resourceInvested=house.power.invested}}
    {{/if}}
    {{#if house.wealth.hasHoldings}}
        {{> (resourceHoldings) resourceName="CS.sheets.house.resources.wealth"  holdings=house.holdings.wealth resourceTotal=house.wealth.total resourceInvested=house.wealth.invested}}
    {{/if}}
</div>