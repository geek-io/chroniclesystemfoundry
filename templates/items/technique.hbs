<div class="cs-item-sheet flexcol {{cssClass}}">
    {{> "systems/chroniclesystem/templates/items/partials/header-delete.hbs"}}
    <nav class="sheet-tabs tabs flexrow" data-group="primary">
        {{#each tabs as |tab|}}
            <a class="item {{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">{{localize tab.label}}</a>
        {{/each}}
    </nav>
    <main class="sheet-body flexrow">
        {{> "systems/chroniclesystem/templates/items/tabs/technique-details-tab.hbs"}}
        {{> "systems/chroniclesystem/templates/items/tabs/technique-works-tab.hbs"}}
    </main>
</div>
