<div class="tab flexrow works {{tabs.works.cssClass}}" data-group="primary" data-tab="works">
    <div>
        <header class="header-field flexrow">
            <span>{{localize "CS.sheets.techniqueItem.tabs.works"}}</span>
            <div class="header-field-add">
                <a data-action="addListEntry" data-list="works" data-tooltip="CS.sheets.generalLabels.add"><i class="fa fa-plus"></i></a>
            </div>
        </header>
        <ol class="work-list list">
            {{#each works as |work id|}}
                <li class="work item flexrow">
                    <!--suppress HtmlFormInputWithoutLabel -->
                    <div>
                        <div class="flexrow">
                            {{> (csFormGroup)
                                    id=(concat "system.works." id ".name")
                                    labelText="CS.sheets.generalLabels.name"
                                    inputCssClass="size200"
                                    value=work.name
                                    dataType="String"
                            }}
                            <div class="flexrow size125">
                                <div class="form-group">
                                    <label for="type">{{localize "CS.sheets.techniqueItem.type"}}</label>
                                    <select name="system.works.{{id}}.type" class="size75">
                                        {{selectOptions ../types selected=work.type localize=true}}
                                    </select>
                                </div>
                                <div class="form-group size125">
                                    <label for="cost">{{localize "CS.sheets.techniqueItem.cost"}}</label>
                                    <select name="system.works.{{id}}.cost" class="size150">
                                        {{selectOptions ../costs selected=work.cost localize=true}}
                                    </select>
                                </div>
                            </div>
                        </div>
                        {{#ifEquals work.type "RITUAL"}}
                            <div class="flexrow">
                                {{> (csFormGroup)
                                        id=(concat "system.works." id ".test.alignment")
                                        labelText="CS.sheets.techniqueItem.test.alignment"
                                        value=work.test.alignment
                                        dataType="String"
                                }}
                                {{> (csFormGroup)
                                    id=(concat "system.works." id ".test.invocation")
                                    labelText="CS.sheets.techniqueItem.test.invocation"
                                    value=work.test.invocation
                                    dataType="String"
                                }}
                                {{> (csFormGroup)
                                        id=(concat "system.works." id ".test.unleashing")
                                        labelText="CS.sheets.techniqueItem.test.unleashing"
                                        value=work.test.unleashing
                                        dataType="String"
                                }}
                            </div>
                        {{/ifEquals}}
                        <div class="flexrow">
                            {{#ifEquals work.type "SPELL"}}
                                <div class="size50">
                                    {{> (csFormGroup)
                                            id=(concat "system.works." id ".test.spellcasting")
                                            labelText="CS.sheets.techniqueItem.test.spellcasting"
                                            value=work.test.spellcasting
                                            dataType="String"
                                    }}
                                </div>
                            {{/ifEquals}}
                            {{> (csFormGroup)
                                    id=(concat "system.works." id ".resonance")
                                    labelText="CS.sheets.techniqueItem.resonance"
                                    value=work.resonance
                                    dataType="String"
                            }}
                        </div>

                        <header class="subheader-field">
                            <span>{{localize "CS.sheets.generalLabels.description"}}</span>
                        </header>
                        <div class="form-group">
                            {{csEditor work.description target=(concat "system.works." id ".description") enriched=work.enrichedDescription uuid=../item.uuid editable=../editable}}
                        </div>
                    </div>
                    <a class="item-controls" data-action="deleteListEntry" data-list="works" data-id="{{id}}"><i class="fas fa-trash"></i></a>
                </li>
            {{/each}}
        </ol>
    </div>
</div>
