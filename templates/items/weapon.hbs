<div class="cs-item-sheet flexcol {{cssClass}}">
    {{> "systems/chroniclesystem/templates/items/partials/header-delete.hbs"}}
    <main class="sheet-body flexrow">
        <section class="item-stats">
            <header class="header-field">
                <span>{{localize "CS.sheets.generalLabels.details"}}</span>
            </header>
            {{> (csFormGroup) id="system.specialty" labelText="CS.sheets.weaponItem.specialty" inputCssClass="medium-field" value=system.specialty placeHolder="CS.sheets.weaponItem.specialtyHint" dataType="String"}}
            {{> (csFormGroup) id="system.damage" labelText="CS.sheets.weaponItem.damage" inputCssClass="medium-field" value=system.damage placeHolder="CS.sheets.weaponItem.damageHint" dataType="String"}}
            {{> (csFormGroup) id="system.training" labelText="CS.sheets.weaponItem.training" inputCssClass="small-field" value=system.training dataType="Number"}}
            {{> (csFormGroup) id="system.reach" labelText="CS.sheets.weaponItem.reach" inputCssClass="small-field" value=system.reach dataType="String"}}
            {{> (csFormGroup) id="system.range" labelText="CS.sheets.weaponItem.range" inputCssClass="small-field" value=system.range dataType="String"}}
            {{> "systems/chroniclesystem/templates/items/partials/physical-item.hbs"}}
            {{> "systems/chroniclesystem/templates/items/partials/equipment-item.hbs"}}
            {{> "systems/chroniclesystem/templates/items/partials/source-field.hbs"}}
        </section>
        <section class="description">
            {{> "systems/chroniclesystem/templates/items/partials/description.hbs"}}
            {{> "systems/chroniclesystem/templates/items/partials/qualities-list.hbs"}}
        </section>
    </main>
</div>
