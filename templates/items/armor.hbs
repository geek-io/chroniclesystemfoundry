<div class="cs-item-sheet flexcol {{cssClass}}">
    {{> "systems/chroniclesystem/templates/items/partials/header-delete.hbs"}}
    <main class="sheet-body flexrow">
        <section class="item-stats">
            <header class="header-field">
                <span>{{localize "CS.sheets.generalLabels.details"}}</span>
            </header>
            {{> (csFormGroup) id="system.rating" labelText="CS.sheets.armorItem.rating" inputCssClass="small-field" value=system.rating dataType="Number"}}
            {{> (csFormGroup) id="system.penalty" labelText="CS.sheets.armorItem.penalty" inputCssClass="small-field" value=system.penalty dataType="Number"}}
            {{> (csFormGroup) id="system.bulk" labelText="CS.sheets.armorItem.bulk" inputCssClass="small-field" value=system.bulk dataType="Number"}}
            {{> "systems/chroniclesystem/templates/items/partials/physical-item.hbs"}}
            {{> "systems/chroniclesystem/templates/items/partials/equipment-item.hbs"}}
            {{> "systems/chroniclesystem/templates/items/partials/source-field.hbs"}}
        </section>
        <section class="description">
            {{> "systems/chroniclesystem/templates/items/partials/description.hbs"}}
            {{> "systems/chroniclesystem/templates/items/partials/qualities-list.hbs"}}
        </section>
    </main>
</div>
