<div class="cs-item-sheet flexcol {{cssClass}}">
    {{> "systems/chroniclesystem/templates/items/partials/header-delete.hbs"}}
    <main class="sheet-body flexrow">
        <section class="item-stats">
            <header class="header-field">
                <span>{{localize "CS.sheets.generalLabels.details"}}</span>
            </header>
            {{> (csFormGroup) id="system.delivery" labelText="CS.sheets.poison.delivery" inputCssClass="medium-field" value=system.delivery dataType="String"}}
            {{> (csFormGroup) id="system.virulence" labelText="CS.sheets.poison.virulence" inputCssClass="medium-field" value=system.virulence dataType="String"}}
            {{> (csFormGroup) id="system.frequency" labelText="CS.sheets.poison.frequency" inputCssClass="medium-field" value=system.frequency dataType="String"}}
            {{> (csFormGroup) id="system.toxicity" labelText="CS.sheets.poison.toxicity" inputCssClass="small-field" value=system.toxicity dataType="Number"}}
            {{> (csFormGroup) id="system.diagnosis" labelText="CS.sheets.poison.diagnosis" inputCssClass="small-field" value=system.diagnosis dataType="Number"}}
            {{> "systems/chroniclesystem/templates/items/partials/physical-item.hbs"}}
            {{> "systems/chroniclesystem/templates/items/partials/equipment-item.hbs"}}
            {{> "systems/chroniclesystem/templates/items/partials/source-field.hbs"}}
        </section>
        <section class="description poison">
            {{> "systems/chroniclesystem/templates/items/partials/description.hbs"}}
            <header class="header-field"><span>{{localize "CS.sheets.poison.effects"}}</span></header>
            <div class="form-group description-text">
                {{csEditor system.effects target="system.effects" enriched=enriched.effects uuid=item.uuid editable=editable}}
            </div>
            <header class="header-field"><span>{{localize "CS.sheets.poison.recovery"}}</span></header>
            <div class="form-group description-text">
                {{csEditor system.recovery target="system.recovery" enriched=enriched.recovery uuid=item.uuid editable=editable}}
            </div>
        </section>
    </main>
</div>
