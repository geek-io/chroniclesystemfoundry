<div class="cs-item-sheet flexcol {{cssClass}}">
    {{> "systems/chroniclesystem/templates/items/partials/header-delete.hbs"}}
    <main class="sheet-body flexrow">
        <section class="item-stats">
            <header class="header-field">
                <span>{{localize "CS.sheets.generalLabels.details"}}</span>
            </header>
            {{#if item.isOwned}}
                {{> (csFormGroup) id="system.rating" labelText="CS.sheets.generalLabels.rating" inputCssClass="small-field" value=system.rating dataType="Number"}}
                {{> (csFormGroup) id="system.modifier" labelText="CS.sheets.generalLabels.modifier" inputCssClass="small-field" value=system.modifier dataType="Number"}}
            {{/if}}
            {{> "systems/chroniclesystem/templates/items/partials/source-field.hbs"}}
        </section>
        <section class="description">
            {{> "systems/chroniclesystem/templates/items/partials/description.hbs"}}
            <header class="header-field flexrow">
                <div class="header-title">
                    <span>{{localize "CS.sheets.abilityItem.specialties"}}</span>
                </div>
                <div class="header-field-add">
                    <a data-action="addListEntry" data-list="specialties" data-tooltip="CS.sheets.generalLabels.add"><i class="fa fa-plus"></i></a>
                </div>
            </header>
            <ol class="specialties-list list">
                {{#each specialties as |specialty id|}}
                    <li class="specialty item flexrow">
                        <input class="big-field" type="text" name="system.specialties.{{id}}.name" value="{{specialty.name}}"
                               placeholder="{{localize "CS.sheets.abilityItem.specialtyName"}}" data-dtype="String"/>
                        {{#if ../item.isOwned}}
                            <input class="small-field" type="text" name="system.specialties.{{id}}.rating" value="{{specialty.rating}}"
                                   placeholder="{{localize "CS.sheets.generalLabels.rating"}}" data-dtype="Number"/>
                            <input class="small-field" type="text" name="system.specialties.{{id}}.modifier" value="{{specialty.modifier}}"
                                   placeholder="{{localize "CS.sheets.generalLabels.modifier"}}" data-dtype="Number"/>
                        {{/if}}
                        <a class="item-controls" data-action="deleteListEntry" data-list="specialties" data-id="{{id}}"><i class="fas fa-trash"></i></a>
                    </li>
                {{/each}}
            </ol>
        </section>
    </main>
</div>
