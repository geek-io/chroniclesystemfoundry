    {
      "name": "Kirlian '3darkman' Silvestre",
      "discord": "Kirlian#1814",
      "flags": {}
    },
    {
      "name": "Geek IO Dev Team",
      "url": "https://geek-io.net/discord",
      "flags": {}
    }
  ],
